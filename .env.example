# =============================================================
#  CloudBase Lab — Example configuration
#  Copy this file to .env and fill in real values.
#  cp .env.example .env
# =============================================================

# --- Ports (direct access, change if they conflict) ---
HOMEPAGE_PORT=8080
NEXTCLOUD_PORT=8081
ADMINER_PORT=8082
UPTIMEKUMA_PORT=8083
PORTAINER_PORT=8084
# Vaultwarden's direct port is bound to 127.0.0.1 only (see docker-compose.yml).
VAULTWARDEN_PORT=8085

# --- Reverse proxy (Traefik) ---
# Host ports Traefik listens on.
HTTP_PORT=80
HTTPS_PORT=443
# Base domain for local hostnames: homepage.<domain>, nextcloud.<domain>,
# adminer.<domain>, uptime.<domain>, portainer.<domain>,
# vaultwarden.<domain>, traefik.<domain>.
# Point these at 127.0.0.1 in /etc/hosts (see README). Switch to a real
# domain later to enable Let's Encrypt.
CLOUDBASE_DOMAIN=cloudbase.local
# Fixed Docker subnet so Nextcloud's trusted_proxies is deterministic.
CLOUDBASE_SUBNET=172.28.0.0/16

# --- Automatic updates (Watchtower) ---
# Watchtower only updates containers that explicitly opt in with the label
# com.centurylinklabs.watchtower.enable=true (see docker-compose.yml).
# Cron schedule (6-field, with seconds) for the image update check.
# The schedule is interpreted in the timezone set by TZ below (local time).
# Default: 04:00 every day, just after the 03:00 backup timer.
WATCHTOWER_SCHEDULE=0 0 4 * * *
# Local timezone so the schedule matches wall-clock time.
TZ=Europe/Zurich

# --- Vaultwarden (password manager) ---
# Registration is CLOSED by default. To create your first account, set this to
# true, start the stack, register at https://vaultwarden.cloudbase.local, then
# set it back to false and recreate the container. Leaving it open lets anyone
# who can reach the URL create an account.
VAULTWARDEN_SIGNUPS_ALLOWED=false
# The /admin panel is disabled while this is empty (safe default). To enable it,
# generate a token yourself and paste the Argon2 hash here, e.g.:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# Do NOT commit a real token to Git. Leave empty to keep /admin disabled.
VAULTWARDEN_ADMIN_TOKEN=

# --- MariaDB ---
DB_ROOT_PASSWORD=your_root_password_here
DB_NAME=nextcloud
DB_USER=admin
DB_PASSWORD=your_db_password_here

# --- Nextcloud Admin ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=your_admin_password_here
